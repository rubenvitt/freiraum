{
  "name": "@freiraum/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "gen": "openapi-typescript ../openapi/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
