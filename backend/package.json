{
  "name": "@freiraum/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "openapi": "tsx src/openapi-export.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@hono/zod-openapi": "^1.6.3",
    "@simplewebauthn/server": "^14.1.0",
    "hono": "^4.13.19",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.28.0"
}
