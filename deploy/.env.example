# Kopieren nach deploy/.env und ausfüllen. deploy/.env niemals committen.
POSTGRES_PASSWORD=bitte-langes-zufaelliges-passwort
# Domain, unter der das Backend per HTTPS erreichbar ist (auch RP-ID der Passkeys)
WEBAUTHN_RP_ID=freiraum.example.org
# Optional, Standard: https://<WEBAUTHN_RP_ID>
WEBAUTHN_ORIGINS=
# Optional: App-IDs für Passkeys in iOS/macOS, z. B. TEAMID.dev.example.freiraum
APPLE_APP_IDS=
# Optional: Kategorisierungsvorschläge per LLM über OpenRouter. Ohne Schlüssel bleibt es aus.
# Das Modell muss strukturierte Ausgabe (JSON-Schema) können und Anbieter ohne Datenspeicherung haben.
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_TIMEOUT_MS=20000
# LLM_ZDR=true
# Optional: anderes Image oder anderer Port
# FREIRAUM_IMAGE=ghcr.io/rubenvitt/freiraum-backend:main
# FREIRAUM_BIND=127.0.0.1
# FREIRAUM_PORT=3000
